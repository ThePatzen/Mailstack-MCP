# Copy to .env and replace the examples with deployment-specific values.
APP_PORT=3000
DATA_DIR=./data
IMAP_HOST=mail.example.net
IMAP_PORT=993
IMAP_TLS_MODE=implicit
MCP_STATIC_TOKENS=[]
# Provide exactly one of ENCRYPTION_KEY or ENCRYPTION_KEY_FILE.
# Generate a private 32-byte key and encode it as base64; never commit it.
ENCRYPTION_KEY=
ENCRYPTION_KEY_FILE=
# SMTP tools are disabled unless SMTP_HOST is set.
SMTP_HOST=
SMTP_PORT=465
SMTP_TLS_MODE=implicit
# Set all three for email-code management login; also requires SMTP_HOST.
SMTP_SYSTEM_USER=
SMTP_SYSTEM_PASSWORD=
SMTP_SYSTEM_FROM=
IMAP_SENT_FOLDER=

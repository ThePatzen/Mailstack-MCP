<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light">
  <title>Anmelden · Mailstack MCP</title>
  <link rel="stylesheet" href="/manage/assets/app.css">
  <link rel="stylesheet" href="/manage/assets/typography.css">
</head>
<body class="login-page">
  <main class="login-shell">
    <a class="brand" href="/manage" aria-label="Mailstack MCP Startseite">
      <span class="brand-mark" aria-hidden="true">M</span>
      <span>Mailstack MCP</span>
    </a>
    <section class="login-card" aria-labelledby="page-title">
      <h1 id="page-title"><%= challengeId ? 'Anmeldecode eingeben' : 'Postfach verbinden' %></h1>
      <p class="muted"><% if (challengeId) { %>Geben Sie den Code ein, den wir an <strong class="login-recipient"><%= username %></strong> gesendet haben.<% } else { %>Melden Sie sich mit Ihrem Mailserver-Konto an, um persönliche MCP-Zugriffstoken zu verwalten.<% } %></p>
      <% if (emailAvailable) { %>
        <nav class="login-methods" aria-label="Anmeldemethode">
          <a href="/manage?method=email"<% if (method === 'email') { %> aria-current="page"<% } %>>E-Mail-Code</a>
          <a href="/manage?method=token"<% if (method === 'token') { %> aria-current="page"<% } %>>Verwaltungstoken</a>
        </nav>
      <% } else { %>
        <p class="login-method-note">E-Mail-Codes sind derzeit nicht verfügbar. Melden Sie sich mit dem Verwaltungstoken Ihres Betreibers an.</p>
      <% } %>
      <% if (error) { %><div class="alert alert-error" role="alert"><%= error %></div><% } %>
      <% if (challengeId) { %>
        <% if (!error) { %><p class="alert alert-info" role="status">Code versendet. Er ist ab Anforderung zehn Minuten gültig.</p><% } %>
        <form method="post" action="/manage/login/verify-code" autocomplete="on">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <input type="hidden" name="challengeId" value="<%= challengeId %>">
          <input type="hidden" name="username" value="<%= accountUsername %>">
          <label for="code">Sechsstelliger Anmeldecode</label>
          <input id="code" name="code" type="text" inputmode="numeric" pattern="[0-9]{6}" minlength="6" maxlength="6" autocomplete="one-time-code" aria-describedby="code-note" required>
          <p id="code-note" class="field-note">Der Code kann einmal verwendet werden.</p>
          <button class="button button-primary button-wide" type="submit">Anmelden</button>
        </form>
        <div class="login-restart">
          <a href="/manage?method=email">Anmeldung neu starten und neuen Code anfordern</a>
          <p class="field-note">Geben Sie dafür Ihre Postfachdaten erneut ein.</p>
        </div>
      <% } else if (method === 'email') { %>
        <form method="post" action="/manage/login/code" autocomplete="on">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <label for="username">E-Mail-Adresse Ihres Postfachs</label>
          <input id="username" name="username" type="email" value="<%= username %>" maxlength="320" autocomplete="username" autocapitalize="none" spellcheck="false" aria-describedby="email-note" required>
          <p id="email-note" class="field-note">Der Anmeldecode wird an diese Adresse gesendet.</p>
          <label for="password">IMAP-Passwort</label>
          <input id="password" name="password" type="password" maxlength="4096" autocomplete="current-password" required>
          <button class="button button-primary button-wide" type="submit">Code per E-Mail anfordern</button>
        </form>
      <% } else { %>
        <form method="post" action="/manage/login" autocomplete="on">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <label for="staticToken">Verwaltungstoken</label>
          <input id="staticToken" name="staticToken" type="password" autocomplete="current-password" aria-describedby="token-note" required>
          <p id="token-note" class="field-note">Der Betreiber stellt dieses Token bereit.</p>
          <label for="username">E-Mail oder IMAP-Benutzername</label>
          <input id="username" name="username" type="text" value="<%= username %>" autocomplete="username" autocapitalize="none" spellcheck="false" required>
          <label for="password">IMAP-Passwort</label>
          <input id="password" name="password" type="password" autocomplete="current-password" required>
          <button class="button button-primary button-wide" type="submit">Anmelden</button>
        </form>
      <% } %>
      <p class="login-footnote"><span class="status-dot" aria-hidden="true"></span> Die Verbindung zum Mailserver wird verschlüsselt hergestellt.</p>
    </section>
    <p class="page-caption">Ihr Postfachzugriff bleibt an Ihr persönliches Konto gebunden.</p>
  </main>
</body>
</html>
